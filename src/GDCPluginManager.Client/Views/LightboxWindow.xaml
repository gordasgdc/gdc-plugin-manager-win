<Window x:Class="GDCPluginManager.Client.Views.LightboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Previzualizare imagine"
        Width="900" Height="680" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkSurfaceBrush}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bara de sus: titlul produsului + reset zoom + inchidere. -->
        <Grid Grid.Row="0" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource InkTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ResetButton" Content="Mărime normală" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="ResetZoom_Click" />
                <Button Padding="6" Background="Transparent" BorderThickness="0"
                        ToolTip="Închide (Esc)" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"
                                   Foreground="{StaticResource InkTextMutedBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Zona imaginii. ClipToBounds: cand imaginea e marita, partea care
             iese din cadru nu trebuie sa se reverse peste bara de sus. -->
        <Border Grid.Row="1" Background="#FF0A0A0A" ClipToBounds="True"
                MouseWheel="Image_MouseWheel"
                MouseLeftButtonDown="Image_MouseDown"
                MouseLeftButtonUp="Image_MouseUp"
                MouseMove="Image_MouseMove">
            <!-- Stretch=Uniform (nu UniformToFill ca in card): in preview
                 vrem imaginea INTREAGA, nu decupata. -->
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
                <Image.RenderTransformOrigin>
                    <Point>0.5,0.5</Point>
                </Image.RenderTransformOrigin>
            </Image>
        </Border>

        <!-- Mesaj de eroare, daca imaginea nu se poate incarca (URL extern
             disparut de pe CDN-ul furnizorului). -->
        <TextBlock Grid.Row="1" x:Name="FailedText" Visibility="Collapsed"
                   Text="Imaginea nu a putut fi încărcată"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource InkTextMutedBrush}" />
    </Grid>
</Window>
