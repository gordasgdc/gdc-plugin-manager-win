<Window x:Class="GDCPluginManager.Client.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil utilizator (opțional)"
        Width="360" SizeToContent="Height" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource InkSurfaceBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Profil utilizator (opțional)" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkTextBrush}" Margin="0,0,0,12" />
        <TextBlock Text="Nume" FontSize="11" Foreground="{DynamicResource InkTextMutedBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,10" />
        <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource InkTextMutedBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="EmailBox" Margin="0,0,0,10" />
        <TextBlock Text="ID mașină" FontSize="11" Foreground="{DynamicResource InkTextMutedBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="MachineIdBox" IsReadOnly="True" Margin="0,0,0,16" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Salvează" Click="Save_Click" />
        </Grid>
    </StackPanel>
</Window>
