<Window x:Class="GDCPluginManager.Client.Views.DependencyPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:GDCPluginManager.Client.Converters"
        Title="Verificare &amp; Dependențe Sistem"
        Width="480" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource InkSurfaceBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Verificare &amp; Dependențe Sistem" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource InkTextBrush}" />
        <TextBlock Text="Stare live a componentelor necesare instalării de pluginuri DaVinci Resolve."
                   FontSize="12" Foreground="{DynamicResource InkTextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,14" />

        <Border Background="{DynamicResource InkSurfaceRaisedBrush}" CornerRadius="8">
            <ItemsControl x:Name="DependenciesList" ItemsSource="{Binding AllDependencies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFE2584A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter Property="Fill" Value="#FF4CAF7D" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPresent}" Value="False" />
                                                    <Condition Binding="{Binding IsOptional}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="#FFE8963C" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource InkTextBrush}" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource InkTextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Lipsește" />
                                        <Setter Property="Foreground" Value="#FFE2584A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter Property="Text" Value="OK" />
                                                <Setter Property="Foreground" Value="#FF4CAF7D" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPresent}" Value="False" />
                                                    <Condition Binding="{Binding IsOptional}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="Opțional" />
                                                <Setter Property="Foreground" Value="#FFE8963C" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="3" Content="Instalează..." Padding="8,3" FontSize="11"
                                    Click="InstallDependency_Click" Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsPresent}" Value="False" />
                                                    <Condition Binding="{Binding DownloadUrl, Converter={StaticResource NullToVisibility}}" Value="Visible" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reverifică tot" Command="{Binding RefreshDependenciesCommand}" />
            <Button Grid.Column="2" Content="Închide" Click="Close_Click" />
        </Grid>
    </StackPanel>
</Window>
