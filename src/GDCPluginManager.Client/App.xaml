<Application x:Class="GDCPluginManager.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Obligatoriu pentru WPF-UI: fara ui:ControlsDictionary, SymbolIcon
                     nu gaseste fontul de iconite embedded si arata patratele goale
                     ("tofu") pe orice Windows fara "Segoe Fluent Icons" instalat
                     (confirmat pe masina de test — Windows fara acest font). -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- [2026-08-29, Regula 24] Dictionarul de CULORI e acum separat de
                     stilurile din Theme.xaml — indexul lui (2, mai jos: 0=Themes,
                     1=Controls, 2=Colors, 3=Styles) e cel pe care
                     WindowsThemeManager.cs il inlocuieste la runtime intre
                     Theme.Dark.xaml si Theme.Light.xaml. Theme.xaml (stilurile)
                     foloseste DOAR DynamicResource pentru culori, ca schimbarea sa se
                     vada instant, fara sa reconstruiasca nicio fereastra. Dark e
                     implicit la pornire — WindowsThemeManager.ApplyNow() (apelat din
                     App.xaml.cs) suprascrie cu preferinta salvata, daca exista. -->
                <ResourceDictionary Source="Styles/Theme.Dark.xaml" />
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
