<Window x:Class="GDCPluginManager.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GDCPluginManager.Client.ViewModels"
        xmlns:conv="clr-namespace:GDCPluginManager.Client.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="GDC Plugin Manager"
        Icon="Assets/app.ico"
        Height="780" Width="1180" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CategoryEqualsMultiConverter x:Key="CategoryEquals" />
        <conv:EnumEqualsVisibilityConverter x:Key="PageVisible" />
        <conv:EnumEqualsBoolConverter x:Key="PageEquals" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- PITFALL FIXED 2026-08-24: Image.Source nu accepta un Uri direct
             (ImageSourceConverter stie sa converteasca doar din string) -
             fara acest converter, NICIO coperta nu se vede pe Windows,
             oricare ar fi categoria. Vezi UriToImageSourceConverter.cs. -->
        <conv:UriToImageSourceConverter x:Key="UriToImageSource" />
        <conv:PriceFilterWeightConverter x:Key="PriceFilterWeight" />

        <!-- =====================================================================
             Coperta de card (imagine de prezentare).
             Perechea de pe Mac e CoverThumbnail din CoverImageViews.swift.

             PROCESS: fiecare DataTemplate de card include blocul de mai jos,
             legat la `Cover` (vezi CoverViewModel). Cand adaugi un tip nou de
             card, copiaza blocul si expune si tu o proprietate `Cover` pe
             ViewModel — altfel cardul nou va fi singurul fara imagine.

             WARNING: cele doua elemente (imaginea si iconita de rezerva) se
             exclud prin HasImage. Iconita NU e un placeholder gri: un card
             fara coperta trebuie sa arate exact ca inainte de existenta
             sistemului de imagini.
             ===================================================================== -->
        <Style x:Key="CoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click pentru a mări imaginea" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Un card de produs din catalog. -->
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="140"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Tutorial YouTube — vizibil doar cand produsul are un link setat. -->
                            <Button Padding="4" Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                                    ToolTip="Vezi tutorialul explicativ pentru acest produs"
                                    Command="{Binding OpenTutorialCommand}"
                                    Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                            </Button>
                            <TextBlock Text="{Binding OSBadgeEmoji}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Visibility="{Binding ShowOSBadge, Converter={StaticResource BoolToVisibility}}" />
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- MaxHeight 54 -> 90 (cca. 3 -> 5 randuri): descrierile reale de
                         produs erau taiate la jumatate de fraza. Aceeasi decizie ca
                         lineLimit(5) din PluginCard, pe Mac. -->
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="90" TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="7,2"
                                    ToolTip="{Binding BadgeTooltip}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding PriceLabel}" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Style="{StaticResource MutedTextStyle}"
                                    VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Actualizare disponibila" Foreground="{StaticResource BrandBrush}" FontSize="11"
                               Margin="0,6,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                    <!-- Buton de contact WhatsApp, doar cand instalarea unei resurse PLATITE
                         a esuat (vezi PaidResourceInstallException / ProductViewModel.cs) —
                         port 1:1 al showPaidResourceSupportError din PluginCard (ContentView.swift). -->
                    <Button Content="Contacteaza suportul" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Command="{Binding ContactSupportCommand}"
                            Visibility="{Binding ShowPaidResourceSupportError, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Vezi cerinta "Selector Compatibilitate OS": produs mono-platforma
                         incompatibil cu Windows -> niciun buton de cumparare/instalare,
                         doar acest mesaj. Port 1:1 al `!item.supportedOS.allows` din
                         PluginCard (ContentView.swift, Mac). -->
                    <TextBlock Text="Incompatibil cu sistemul tau" FontSize="12" Foreground="#FFD9534F"
                               Margin="0,12,0,0"
                               Visibility="{Binding IsCompatible, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- Zona de actiune — port 1:1 al actionButton din PluginCard (ContentView.swift):
                         Cumpara (neblocat) / Actualizeaza+Elimina / Instalat+Elimina / Instaleaza. -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsCompatible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding BuyCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Cart24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Cumpara" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="0"
                                Command="{Binding InstallCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                            <!-- Portocaliu-viu cand e disponibila o versiune noua — port 1:1 al
                                 stilizarii butonului "Actualizeaza" din ContentView.swift (Mac). -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="#FFF08A24" />
                                            <Setter Property="BorderBrush" Value="#FFF08A24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon FontSize="14" Margin="0,0,7,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Symbol" Value="ArrowClockwise24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Instaleaza" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Text" Value="Reinstaleaza" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Text" Value="Actualizeaza" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{Binding RemoveCommand}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Un card de curs. -->
        <DataTemplate DataType="{x:Type vm:CourseViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="150"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="HatGraduation24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CourseOptionViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Contacteaza" Padding="8,3" Command="{Binding ContactCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Un card de aplicatie (Aplicatii). -->
        <DataTemplate DataType="{x:Type vm:AppLinkViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="240" MinHeight="110">
                <Grid>
                    <StackPanel>
                        <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center">
                            <TextBlock Text="APLICATIE" FontSize="9" FontWeight="Bold" Foreground="#4EA1F5" />
                        </Border>
                        <!-- Coperta, daca aplicatia are una (vezi CoverButtonStyle mai sus);
                             altfel cade pe simbolul de mai jos (acelasi pattern ca la Magazine). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="56"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="20" Margin="0,10,0,0" Foreground="#4EA1F5"
                                       Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Deschide" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ pentru aceasta aplicatie"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de material (carte/curs online/ghid). -->
        <DataTemplate DataType="{x:Type vm:EducationalResourceViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320" MinHeight="140">
                <Grid>
                    <StackPanel>
                        <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="Bold" Foreground="#4EA1F5" />
                        </Border>
                        <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="170"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                     proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                     In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                                <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="Book24" FontSize="20" Margin="0,10,0,0" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Cumpara" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding BuyCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de eveniment. -->
        <DataTemplate DataType="{x:Type vm:EventViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320" MinHeight="140">
                <Grid>
                    <StackPanel>
                        <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="190"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                     proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                     In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                                <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DateAndLocation}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Detalii/Inscriere" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenDetailsCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de magazin partener. -->
        <DataTemplate DataType="{x:Type vm:PartnerStoreViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280" MinHeight="120">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="130"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Content="Viziteaza" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding VisitCommand}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ServiceCenterViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280" MinHeight="120">
                <StackPanel>
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="110"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <Image Source="{Binding Cover.Url, Converter={StaticResource UriToImageSource}}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Specialization}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Contact rapid" Command="{Binding ContactCommand}" Margin="0,0,8,0" />
                        <Button Content="Website / Locație" Command="{Binding OpenWebsiteCommand}"
                                Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Bara laterala -->
        <Border Grid.Column="0" Background="{StaticResource InkSurfaceBrush}" BorderBrush="{StaticResource InkBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="GDC PLUGIN MANAGER" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,16"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                            <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar"
                                         Margin="8,1"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource CategoryEquals}" Mode="OneWay">
                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}" Mode="OneWay" />
                                        <Binding Mode="OneWay" />
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}" Mode="OneWay" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="16,16" />

                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowCoursesCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Courses, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HatGraduation24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Cursuri" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowEducationalResourcesCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=EducationalResources, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Book24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Materiale" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowEventsCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Events, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Evenimente" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowPartnerStoresCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=PartnerStores, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Magazine partenere" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowServiceCentersCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=ServiceCenters, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Service &amp; Reparații" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowAppsCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Apps, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicatii" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <!-- Aplicatia mobila companion (PWA, gordas.dev/app.html —
                     fost APK/TWA, retras 2026-08-24). -->
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowAndroidCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Android, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicatie mobila" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Separator Margin="16,16" />

                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowLicenseCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=License, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Key24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Licenta" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Separator Margin="16,16" />

                <TextBlock Text="ID MASINA" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,4" />
                <TextBlock Text="{Binding MachineIdDisplay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                           Margin="16,0,16,0" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <!-- Continut principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bara de sus: cautare + refresh — doar pe pagina de catalog. -->
            <Grid Grid.Row="0" Margin="20,20,20,0"
                  Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Catalog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SearchBoxBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="15" Margin="10,0,4,0"
                                       Foreground="{StaticResource InkTextMutedBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="Reincarca" />
                    </StackPanel>
                </Button>

                <!-- Filtru rapid Toate/Gratuite/Premium — cerut explicit
                     2026-08-24, ca cine vrea doar uneltele gratuite sa le
                     gaseasca instant. Randat SUB bara de cautare (nu ca rand
                     nou in grid-ul parinte, ca sa nu deranjez numerotarea
                     Grid.Row existenta mai jos, folosita si de RowSpan). -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Toate" Margin="0,0,8,0" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.All}"
                            FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=All}" />
                    <Button Content="Gratuite" Margin="0,0,8,0" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.Free}"
                            FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Free}" />
                    <Button Content="Premium" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.Paid}"
                            FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Paid}" />
                </StackPanel>
            </Grid>

            <!-- Banner update / eroare -->
            <StackPanel Grid.Row="1" Margin="20,10,20,0">
                <Border Background="{StaticResource InkSurfaceRaisedBrush}" CornerRadius="4" Padding="12,8"
                        Visibility="{Binding UpdateBannerText, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateBannerText}" Foreground="{StaticResource BrandBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- WARNING: acest buton lipsea complet. UpdateDownloadUrl era
                                 setat in MainViewModel dar nu era legat de nimic in XAML,
                                 deci banner-ul anunta o versiune noua si nu oferea NICIO
                                 cale de a o lua - nici macar un link. Daca refaci
                                 banner-ul, pastreaza legatura asta. -->
                            <Button Content="Descarcă" Margin="10,0,0,0"
                                    Command="{Binding DownloadUpdateCommand}"
                                    Visibility="{Binding UpdateDownloadUrl, Converter={StaticResource NullToVisibility}}" />
                            <Button Content="Ascunde" Margin="8,0,0,0" Command="{Binding DismissUpdateBannerCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding LoadError}" Foreground="#FFE8544D" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" />

                <!-- Banner dependinte de sistem lipsa — port 1:1 al DependencyBanner (Mac). -->
                <ItemsControl ItemsSource="{Binding MissingDependencies}"
                              Visibility="{Binding MissingDependencies.Count, Converter={StaticResource ZeroToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFCE8CD" CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="#FFB05B00" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="#FFB05B00" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Instalează"
                                            Command="{Binding DataContext.InstallDependencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Pagina Catalog -->
            <ScrollViewer Grid.Row="2" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Catalog}">
                <ItemsControl ItemsSource="{Binding ProductsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pagina Cursuri -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Courses}">
                <StackPanel>
                    <TextBlock Text="Cursuri" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun curs disponibil momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Courses.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Courses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Materiale -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=EducationalResources}">
                <StackPanel>
                    <TextBlock Text="Materiale" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun material disponibil momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding EducationalResources.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding EducationalResources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Evenimente -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Events}">
                <StackPanel>
                    <TextBlock Text="Evenimente" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun eveniment momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Events.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Magazine partenere -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=PartnerStores}">
                <StackPanel>
                    <TextBlock Text="Magazine partenere" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun magazin partener momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding PartnerStores.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PartnerStores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Service & Reparatii -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=ServiceCenters}">
                <StackPanel>
                    <TextBlock Text="Service &amp; Reparații Echipament" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun service partener momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding ServiceCenters.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ServiceCenters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Aplicatii -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Apps}">
                <StackPanel>
                    <TextBlock Text="Aplicatii" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio aplicatie listata momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Aplicatie mobila — fost "Android"/APK, RETRAS 2026-08-24
                 (cerut explicit: fara certificate, fara erori de instalare,
                 fara APK). Acum e direct PWA-ul gordas.dev/app.html, deschis
                 in browser — merge pe Android SI iPhone. Link fix
                 (MainViewModel.MobileAppUrl), fara nicio cerere de retea.
                 Cod QR: MobileAppQrImage, generat o singura data cu QRCoder
                 (vezi QrCodeImageGenerator.cs). Fundal alb obligatoriu: QR-ul
                 are nevoie de contrast ca sa fie citit, la fel ca pe Mac. -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Android}">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Aplicatia mobila" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Ai catalogul GDC si pe telefon: produse, cursuri, evenimente si magazine partenere, cu functionare offline. Scaneaza codul de mai jos, direct din browser, fara instalare — merge pe Android si pe iPhone." />

                    <Border Background="White" CornerRadius="10" Padding="10" Width="188" Height="188"
                            HorizontalAlignment="Left" Margin="0,0,0,14"
                            Visibility="{Binding MobileAppQrImage, Converter={StaticResource NullToVisibility}}">
                        <Image Source="{Binding MobileAppQrImage}" Width="168" Height="168"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" FontFamily="Consolas"
                               Text="gordas.dev/app.html" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <ui:Button Content="Deschide" Appearance="Primary"
                                   Command="{Binding OpenAndroidPageCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Copiaza linkul" Command="{Binding CopyAndroidLinkCommand}" />
                    </StackPanel>

                    <TextBlock Text="Adauga pe ecranul principal (optional)" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Text="Android (Chrome)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="1. Deschide linkul in Chrome, apoi apasa meniul (⋮) din dreapta sus." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="2. Alege &quot;Adauga pe ecranul principal&quot; — primesti un icon, ca o aplicatie instalata." />
                    <TextBlock Text="iPhone (Safari)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="1. Deschide linkul in Safari, apoi apasa butonul de partajare (patratul cu sageata in sus)." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="2. Alege &quot;Adauga pe ecranul principal&quot; din lista." />
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Licenta -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=License}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left" DataContext="{Binding LicensePane}">
                    <TextBlock Text="Licenta" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,4" />

                    <!-- Status -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                                        <Setter Property="Text" Value="Niciun produs deblocat inca" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                <Setter Property="Text" Value="Produse deblocate" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Text" Value="Aplicatia e gratuita — rasfoieste catalogul si cumpara doar ce vrei sa folosesti." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                <Setter Property="Text" Value="Ai produs(e) deblocat(e) pe viata, pe acest calculator." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Licentele mele -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0"
                            Visibility="{Binding IsLicensed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Licentele mele" Style="{StaticResource HeadingTextStyle}" />
                            <ItemsControl ItemsSource="{Binding OwnedLicenses}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OwnedLicenseViewModel}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Dezactiveaza" Padding="8,3" Command="{Binding DeactivateCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ID masina -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ID-ul acestui calculator" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Trimite acest ID cand cumperi licenta — codul e legat de acest calculator."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource InkBackgroundBrush}" BorderBrush="{StaticResource InkBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding MachineIdDisplay}" FontFamily="Consolas" />
                                </Border>
                                <Button Content="Copiaza" Margin="10,0,0,0" Command="{Binding CopyMachineIdCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activare cod -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding ActivationError}" Foreground="#FFE8544D" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding ActivationError, Converter={StaticResource NullToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding JustActivated, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{StaticResource BrandBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Activat cu succes!" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                            <Button Content="Activeaza" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Padding="20,7" Command="{Binding ActivateCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Cumpara / doneaza -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Vrei sa deblochezi un produs?" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Pretul de pe fiecare card e o donatie, o singura data, care ajuta la dezvoltarea in continuare a produselor."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="20,7"
                                    Command="{Binding OpenWhatsAppCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChatBubblesQuestion24" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Scrie-ne pe WhatsApp" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
