<Window x:Class="GDCPluginManager.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GDCPluginManager.Client.ViewModels"
        xmlns:conv="clr-namespace:GDCPluginManager.Client.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="GDC Plugin Manager"
        Icon="Assets/app.ico"
        Height="780" Width="1180" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:SymbolNameConverter x:Key="SymbolName" />
        <conv:CategoryEqualsMultiConverter x:Key="CategoryEquals" />
        <conv:EnumEqualsVisibilityConverter x:Key="PageVisible" />
        <conv:EnumEqualsBoolConverter x:Key="PageEquals" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisibility" />
        <conv:RecentSearchesVisibleConverter x:Key="RecentSearchesVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- UriToImageSourceConverter A FOST ELIMINAT (2026-08-25): descarcarea
             se face acum direct in CoverViewModel (Bitmap, cu DownloadFailed
             ascultat explicit) - vezi CoverViewModel.cs pentru motivul fix-ului
             (fallback vizual real la esec de descarcare). Image.Source leaga
             acum la `Cover.Bitmap`, nu la `Cover.Url` printr-un converter. -->
        <conv:PriceFilterWeightConverter x:Key="PriceFilterWeight" />

        <!-- =====================================================================
             Coperta de card (imagine de prezentare).
             Perechea de pe Mac e CoverThumbnail din CoverImageViews.swift.

             PROCESS: fiecare DataTemplate de card include blocul de mai jos,
             legat la `Cover` (vezi CoverViewModel). Cand adaugi un tip nou de
             card, copiaza blocul si expune si tu o proprietate `Cover` pe
             ViewModel — altfel cardul nou va fi singurul fara imagine.

             WARNING: cele doua elemente (imaginea si iconita de rezerva) se
             exclud prin HasImage. Iconita NU e un placeholder gri: un card
             fara coperta trebuie sa arate exact ca inainte de existenta
             sistemului de imagini.
             ===================================================================== -->
        <Style x:Key="CoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Click pentru a mări imaginea" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Un card de produs din catalog. -->
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="140"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Tutorial YouTube — vizibil doar cand produsul are un link setat. -->
                            <Button Padding="4" Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                                    ToolTip="Vezi tutorialul explicativ pentru acest produs"
                                    Command="{Binding OpenTutorialCommand}"
                                    Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                            </Button>
                            <ui:SymbolIcon Symbol="{Binding OSBadgeSymbol, Converter={StaticResource SymbolName}}"
                                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource InkTextMutedBrush}" />
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- MaxHeight 54 -> 90 (cca. 3 -> 5 randuri): descrierile reale de
                         produs erau taiate la jumatate de fraza. Aceeasi decizie ca
                         lineLimit(5) din PluginCard, pe Mac. -->
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="90" TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{Binding BadgeBrush}" CornerRadius="9" Padding="7,2"
                                    ToolTip="{Binding BadgeTooltip}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <!-- Suma veche, TAIATA — apare doar cat timp promotia
                                 e activa (Etapa 4), inaintea sumei curente. -->
                            <TextBlock Text="{Binding OriginalPriceLabel}" Margin="8,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"
                                       TextDecorations="Strikethrough"
                                       Visibility="{Binding IsPromoActive, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding PriceLabel}" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Style="{StaticResource MutedTextStyle}"
                                    VerticalAlignment="Center" />
                    </Grid>

                    <!-- Badge "Susținere promoțională" — NICIODATA
                         "reducere"/"discount"/"-X% OFF" pe produse proprii GDC
                         (Regula 3, Partea 1). Limbajul de discount exista
                         exclusiv pe cardul PartnerOffer (brand tert). -->
                    <Border Style="{StaticResource BadgeBorderStyle}" Background="#FFB05B00"
                            HorizontalAlignment="Left" Margin="0,6,0,0"
                            Visibility="{Binding IsPromoActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PromoBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>

                    <TextBlock Text="Actualizare disponibila" Foreground="{StaticResource BrandBrush}" FontSize="11"
                               Margin="0,6,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                    <!-- Buton de contact WhatsApp, doar cand instalarea unei resurse PLATITE
                         a esuat (vezi PaidResourceInstallException / ProductViewModel.cs) —
                         port 1:1 al showPaidResourceSupportError din PluginCard (ContentView.swift). -->
                    <Button Content="Contacteaza suportul" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Command="{Binding ContactSupportCommand}"
                            Visibility="{Binding ShowPaidResourceSupportError, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Vezi cerinta "Selector Compatibilitate OS": produs mono-platforma
                         incompatibil cu Windows -> niciun buton de cumparare/instalare,
                         doar acest mesaj. Port 1:1 al `!item.supportedOS.allows` din
                         PluginCard (ContentView.swift, Mac). -->
                    <TextBlock Text="Incompatibil cu sistemul tau" FontSize="12" Foreground="#FFD9534F"
                               Margin="0,12,0,0"
                               Visibility="{Binding IsCompatible, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- Zona de actiune — port 1:1 al actionButton din PluginCard (ContentView.swift):
                         Cumpara (neblocat) / Actualizeaza+Elimina / Instalat+Elimina / Instaleaza. -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsCompatible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding BuyCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Cart24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Doneaza" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="0"
                                Command="{Binding InstallCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                            <!-- Albastru distinct cand e disponibila o versiune noua — dupa
                                 retema Shift (2026-08-26), butonul Primary e deja amber, deci
                                 vechiul portocaliu de aici s-ar fi confundat cu el; albastru
                                 (aceeasi nuanta ca badge-ul "APLICATIE" de mai jos) ramane
                                 clar distinct de accentul amber. -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="#FF4EA1F5" />
                                            <Setter Property="BorderBrush" Value="#FF4EA1F5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon FontSize="14" Margin="0,0,7,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ArrowDownload24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Symbol" Value="ArrowClockwise24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Instaleaza" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Text" Value="Reinstaleaza" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Text" Value="Actualizeaza" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{Binding RemoveCommand}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                        </Button>
                    </Grid>

                    <!-- Rand de linkuri suplimentare (Etapa 2, 2026-08-29) —
                         port al `extraLinksRow` de pe Mac. Fiecare iconita
                         apare DOAR daca linkul ei e completat; randul intreg
                         dispare daca nu exista niciunul (StackPanel gol nu
                         ocupa spatiu vizual, butoanele sunt Collapsed). -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenPurchaseCommand}"
                                ToolTip="Cumpara extern"
                                Visibility="{Binding HasPurchase, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Cart24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenDemoCommand}"
                                ToolTip="Demo / previzualizare"
                                Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenFacebookCommand}"
                                ToolTip="Facebook"
                                Visibility="{Binding HasFacebook, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Share24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenSocialYoutubeCommand}"
                                ToolTip="YouTube"
                                Visibility="{Binding HasSocialYoutube, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Video24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenInstagramCommand}"
                                ToolTip="Instagram"
                                Visibility="{Binding HasInstagram, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenTiktokCommand}"
                                ToolTip="TikTok"
                                Visibility="{Binding HasTiktok, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================================================================
             Un card de Resursa Download (Etapa 2, 2026-08-29).
             Mirror al cardului Audio (descarcare directa, fara auto-install),
             PLUS licentiere completa ca la Produse: badge Gratuit/Proba/
             Licenta, buton WhatsApp cu ID masina cand e blocata, "Descarca"
             doar dupa deblocare, si acelasi rand de linkuri suplimentare.
             ================================================================ -->
        <DataTemplate DataType="{x:Type vm:DownloadResourceViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320">
                <StackPanel>
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="140">
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill" />
                        </Border>
                    </Button>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Iconita categoriei, ca fallback vizual cand nu exista coperta. -->
                        <ui:SymbolIcon Grid.Column="0" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrandBrush}"
                                       Symbol="{Binding CategorySymbol, Converter={StaticResource SymbolName}}"
                                       Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:SymbolIcon Grid.Column="2" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkTextMutedBrush}"
                                       Symbol="{Binding OSBadgeSymbol, Converter={StaticResource SymbolName}}" />
                    </Grid>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{Binding BadgeBrush}">
                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding PriceLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#FF6E7681" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>


                    <!-- Susținere promoțională (Etapa 4). Suma veche apare
                         TAIATA langa cea curenta, cu un badge care spune
                         explicit "Susținere promoțională" — niciodata
                         "reducere"/"discount"/"-X%" pe continut propriu GDC
                         (Regula 3, Partea 1). Randul intreg apare doar cat
                         timp promotia e activa. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsPromoActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding OriginalPriceLabel}" FontSize="12" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextDecorations="Strikethrough" Margin="0,0,8,0" />
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#FFB05B00">
                            <TextBlock Text="{Binding PromoBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <!-- Deblocata: buton de descarcare. Blocata: WhatsApp cu ID masina. -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DownloadCommand}"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Descarca" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BuyCommand}"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChatBubblesQuestion24" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Deblocheaza" />
                        </StackPanel>
                    </Button>

                    <!-- "Unde l-ai salvat?" (Etapa 5) — stare pur locala, per
                         resursa. Apare DOAR pe resurse deblocate (nu are sens
                         sa intrebi unde ai salvat ceva ce n-ai descarcat inca),
                         exact ca pe Mac. -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                        <!-- Fara folder ales inca. -->
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" HorizontalAlignment="Left"
                                Command="{Binding ChooseFolderCommand}"
                                Visibility="{Binding HasSavedFolder, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Unde l-ai salvat?" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <!-- Cu folder retinut: calea + deschide + schimba. -->
                        <StackPanel Visibility="{Binding HasSavedFolder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SavedFolder}" Style="{StaticResource MutedTextStyle}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenFolderCommand}"
                                        ToolTip="Deschide folderul">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Deschide" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding ChooseFolderCommand}">
                                    <TextBlock Text="Schimbă" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding ForgetFolderCommand}">
                                    <TextBlock Text="Uită" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenTutorialCommand}"
                                ToolTip="Tutorial"
                                Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenPurchaseCommand}"
                                ToolTip="Cumpara extern"
                                Visibility="{Binding HasPurchase, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Cart24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenDemoCommand}"
                                ToolTip="Demo / previzualizare"
                                Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenFacebookCommand}"
                                ToolTip="Facebook"
                                Visibility="{Binding HasFacebook, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Share24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenSocialYoutubeCommand}"
                                ToolTip="YouTube"
                                Visibility="{Binding HasSocialYoutube, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Video24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenInstagramCommand}"
                                ToolTip="Instagram"
                                Visibility="{Binding HasInstagram, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenTiktokCommand}"
                                ToolTip="TikTok"
                                Visibility="{Binding HasTiktok, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================================================================
             Un card de Oferta Partenera (Etapa 4, 2026-08-29).
             SINGURUL card unde limbajul de "discount"/procent e permis — e o
             relatie comerciala cu un brand TERT. Produsele/resursele proprii
             GDC folosesc badge-ul "Sustinere promotionala", niciodata acesta.
             ================================================================ -->
        <DataTemplate DataType="{x:Type vm:PartnerOfferViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320">
                <StackPanel>
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="140">
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill" />
                        </Border>
                    </Button>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding BrandName}" Style="{StaticResource HeadingTextStyle}"
                                   FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <!-- Badge ROSU de discount — doar aici, doar daca e completat. -->
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="#FFE2584A"
                                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DiscountText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Cod de cupon + copiere rapida, daca exista. -->
                    <Grid Margin="0,0,0,8" Visibility="{Binding HasCoupon, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource InkSurfaceRaisedBrush}" CornerRadius="4" Padding="8,5">
                            <TextBlock Text="{Binding CouponCode}" FontFamily="Consolas" FontSize="13" />
                        </Border>
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CopyCouponCommand}" ToolTip="Copiaza codul">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="15" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Vezi oferta" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenTutorialCommand}"
                                ToolTip="Video"
                                Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenFacebookCommand}"
                                ToolTip="Facebook"
                                Visibility="{Binding HasFacebook, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Share24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenSocialYoutubeCommand}"
                                ToolTip="YouTube"
                                Visibility="{Binding HasSocialYoutube, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Video24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenInstagramCommand}"
                                ToolTip="Instagram"
                                Visibility="{Binding HasInstagram, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource ExtraLinkButtonStyle}" Command="{Binding OpenTiktokCommand}"
                                ToolTip="TikTok"
                                Visibility="{Binding HasTiktok, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================================================================
             Un card de Pachet/Bundle (Etapa 9, 2026-08-29).
             Lista de continut e rezolvata LIVE din catalog (vezi
             BundleViewModel.ResolveEntries) — un ID sters intre timp e omis
             silentios, cardul nu crapa. Suma individuala apare TAIATA langa
             pretul pachetului, si doar daca e strict mai mare.
             ================================================================ -->
        <DataTemplate DataType="{x:Type vm:BundleViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="340">
                <StackPanel>
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="140">
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill" />
                        </Border>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#FF7C7CF0">
                            <TextBlock Text="PACHET" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                               FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Continutul pachetului. -->
                    <TextBlock Text="Include:" Style="{StaticResource MutedTextStyle}" FontSize="11"
                               FontWeight="Bold" Margin="0,0,0,4"
                               Visibility="{Binding Entries.Count, Converter={StaticResource NonZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <ui:SymbolIcon FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkTextMutedBrush}"
                                                   Symbol="{Binding Symbol, Converter={StaticResource SymbolName}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Suma individuala taiata + pretul pachetului. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding IndividualTotalDisplay}" FontSize="12" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}" TextDecorations="Strikethrough"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding ShowIndividualTotal, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding BundlePriceDisplay}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BuyCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChatBubblesQuestion24" FontSize="14" Margin="0,0,7,0" />
                            <TextBlock Text="Cumpără pachetul" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ExtraLinkButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{Binding OpenTutorialCommand}" ToolTip="Video"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Un card de curs. -->
        <DataTemplate DataType="{x:Type vm:CourseViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="150"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="HatGraduation24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CourseOptionViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding PriceDisplay}" Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Contacteaza" Padding="8,3" Command="{Binding ContactCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Un card de aplicatie (Aplicatii). -->
        <DataTemplate DataType="{x:Type vm:AppLinkViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="240" MinHeight="110">
                <Grid>
                    <StackPanel>
                        <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center">
                            <TextBlock Text="APLICATIE" FontSize="9" FontWeight="Bold" Foreground="#4EA1F5" />
                        </Border>
                        <!-- Coperta, daca aplicatia are una (vezi CoverButtonStyle mai sus);
                             altfel cade pe simbolul de mai jos (acelasi pattern ca la Magazine). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="56"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="20" Margin="0,10,0,0" Foreground="#4EA1F5"
                                       Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Deschide" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ pentru aceasta aplicatie"
