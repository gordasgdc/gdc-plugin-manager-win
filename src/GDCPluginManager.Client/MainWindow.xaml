                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card audio (sectiunea Audio, modelata pe Aplicatii + Description ca la Materiale). -->
        <DataTemplate DataType="{x:Type vm:AudioTrackViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="240" MinHeight="110">
                <Grid>
                    <StackPanel>
                        <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center">
                            <TextBlock Text="AUDIO" FontSize="9" FontWeight="Bold" Foreground="#7C7CF0" />
                        </Border>
                        <!-- Coperta, daca elementul are una — altfel cade pe simbolul de mai jos. -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="56"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="20" Margin="0,10,0,0" Foreground="#7C7CF0"
                                       Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                        <Button Content="Descarca" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ pentru acest element audio"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de material (carte/curs online/ghid). -->
        <DataTemplate DataType="{x:Type vm:EducationalResourceViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320" MinHeight="140">
                <Grid>
                    <StackPanel>
                        <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="Bold" Foreground="#4EA1F5" />
                        </Border>
                        <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="170"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                     proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                     In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                                <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="Book24" FontSize="20" Margin="0,10,0,0" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Doneaza" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding BuyCommand}" />
                    </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de eveniment. -->
        <DataTemplate DataType="{x:Type vm:EventViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="320" MinHeight="140">
                <Grid>
                    <StackPanel>
                        <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                        <Button Style="{StaticResource CoverButtonStyle}"
                                Command="{Binding Cover.ShowCommand}"
                                Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6" ClipToBounds="True" Height="190"
                                    Background="{StaticResource InkSurfaceRaisedBrush}">
                                <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                     proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                     In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                                <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Button>
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DateAndLocation}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="Detalii/Inscriere" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding OpenDetailsCommand}" />
                    
                    <!-- Buton harta (Etapa 5) — nu se randeaza deloc daca
                         adresa lipseste sau e non-fizica ("Online" etc.). -->
                    <Button Style="{StaticResource ExtraLinkButtonStyle}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding OpenMapsCommand}" ToolTip="Vezi pe harta"
                            Visibility="{Binding HasMaps, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Location24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Vezi pe hartă" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                    <Button Padding="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Vezi tutorialul explicativ"
                            Command="{Binding OpenTutorialCommand}"
                            Visibility="{Binding HasYoutube, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource InkTextMutedBrush}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Un card de magazin partener. -->
        <DataTemplate DataType="{x:Type vm:PartnerStoreViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280" MinHeight="120">
                <StackPanel>
                    <!-- Coperta, daca produsul are una (vezi CoverButtonStyle mai sus). -->
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="130"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <!-- UniformToFill + clip: cardurile au latime fixa, coperile nu au
                                 proportii fixe. Umplem si taiem, ca sa nu ramana benzi goale.
                                 In lightbox e invers (Uniform) — acolo vrem imaginea intreaga. -->
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Content="Viziteaza" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding VisitCommand}" />
                
                    <!-- Buton harta (Etapa 5) — nu se randeaza deloc daca
                         adresa lipseste sau e non-fizica ("Online" etc.). -->
                    <Button Style="{StaticResource ExtraLinkButtonStyle}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding OpenMapsCommand}" ToolTip="Vezi pe harta"
                            Visibility="{Binding HasMaps, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Location24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Vezi pe hartă" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ServiceCenterViewModel}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="280" MinHeight="120">
                <StackPanel>
                    <Button Style="{StaticResource CoverButtonStyle}"
                            Command="{Binding Cover.ShowCommand}"
                            Visibility="{Binding Cover.HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="6" ClipToBounds="True" Height="110"
                                Background="{StaticResource InkSurfaceRaisedBrush}">
                            <Image Source="{Binding Cover.Bitmap}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Button>
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{StaticResource BrandBrush}" Visibility="{Binding Cover.HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Specialization}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Contact rapid" Command="{Binding ContactCommand}" Margin="0,0,8,0" />
                        <Button Content="Website / Locație" Command="{Binding OpenWebsiteCommand}"
                                Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                
                    <!-- Buton harta (Etapa 5) — nu se randeaza deloc daca
                         adresa lipseste sau e non-fizica ("Online" etc.). -->
                    <Button Style="{StaticResource ExtraLinkButtonStyle}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Command="{Binding OpenMapsCommand}" ToolTip="Vezi pe harta"
                            Visibility="{Binding HasMaps, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Location24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Vezi pe hartă" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Redimensionabila (GridSplitter dedesubt) - lipsea complet,
                 latimea 200 era fixa "in cod", nu doar valoarea implicita.
                 240 implicit (mai generos, cerut explicit) intre 200-420. -->
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Bara laterala -->
        <Border Grid.Column="0" Background="{StaticResource InkSurfaceBrush}" BorderBrush="{StaticResource InkBorderBrush}"
                BorderThickness="0,0,1,0">
            <!-- BUG REAL gasit 2026-08-26: sidebar-ul era un StackPanel simplu,
                 fara ScrollViewer - pe o fereastra mai scunda decat continutul
                 (multe categorii + Cursuri/Materiale/etc. + Licenta), tot ce
                 venea dupa "Licenta" (Profil/HWID, versiunea) era pur si simplu
                 CLIPAT, invizibil, fara nicio bara de scroll care sa arate ca
                 mai exista continut. Fix: Grid cu 2 randuri - continutul
                 categoriilor scroll-abil (Row 0, *), footer-ul (Profil/HWID +
                 versiune) FIX, mereu vizibil (Row 1, Auto), nu mai poate fi
                 clipat sub nicio inaltime de fereastra. -->
            <Grid Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="GDC PLUGIN MANAGER" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,16"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                            <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar"
                                         Margin="8,1"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource CategoryEquals}" Mode="OneWay">
                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}" Mode="OneWay" />
                                        <Binding Mode="OneWay" />
                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}" Mode="OneWay" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Audio — plasata aici, langa categoriile LUT/DCTL/OFX/PowerGrade
                     de mai sus (nu langa Cursuri/Materiale/etc.), la fel ca pe Mac. -->
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowAudioTracksCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=AudioTracks, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Margin="0,0,10,0" Foreground="#7C7CF0" />
                        <TextBlock Text="Audio" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <!-- RESURSE DOWNLOAD (Etapa 2, 2026-08-29) — 4 rubrici noi,
                     una per DownloadCategory, langa Audio (acelasi tip de
                     continut: descarcare directa, fara auto-instalare in
                     Resolve), exact ca gruparea de pe Mac. -->
                <TextBlock Text="RESURSE DOWNLOAD" Style="{StaticResource MutedTextStyle}"
                           FontSize="10" FontWeight="Bold" Margin="16,14,0,6" />
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowDownloadCategoryCommand}" CommandParameter="{x:Static vm:SidebarPage.DownloadLut}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=DownloadLut, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eyedropper24" FontSize="16" Margin="0,0,10,0" Foreground="#4ECDA4" />
                        <TextBlock Text="LUT-uri" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowDownloadCategoryCommand}" CommandParameter="{x:Static vm:SidebarPage.DownloadSfx}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=DownloadSfx, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Margin="0,0,10,0" Foreground="#4EBFCD" />
                        <TextBlock Text="Efecte Audio" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowDownloadCategoryCommand}" CommandParameter="{x:Static vm:SidebarPage.DownloadVfx}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=DownloadVfx, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,10,0" Foreground="#A97CF0" />
                        <TextBlock Text="Efecte Video" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowDownloadCategoryCommand}" CommandParameter="{x:Static vm:SidebarPage.DownloadPlugin}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=DownloadPlugin, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" Margin="0,0,10,0" Foreground="#E0A34E" />
                        <TextBlock Text="Plugin-uri" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Separator Margin="16,16" />

                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowCoursesCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Courses, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="HatGraduation24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Cursuri" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowEducationalResourcesCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=EducationalResources, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Book24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Materiale" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowEventsCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Events, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Calendar24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Evenimente" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowPartnerStoresCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=PartnerStores, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShoppingBag24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Magazine partenere" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowServiceCentersCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=ServiceCenters, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Service &amp; Reparații" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <!-- Oferte Parteneri (Etapa 4, 2026-08-29) — grup COMUNITATE. -->
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowPartnerOffersCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=PartnerOffers, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Tag24" FontSize="16" Margin="0,0,10,0" Foreground="#E2584A" />
                        <TextBlock Text="Oferte Parteneri" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowBundlesCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Bundles, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Box24" FontSize="16" Margin="0,0,10,0" Foreground="#7C7CF0" />
                        <TextBlock Text="Pachete" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowMyAppsCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=MyApps, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Rocket24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicatiile Mele" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowAppsCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Apps, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicatii" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <!-- Aplicatia mobila companion (PWA, gordas.dev/app.html —
                     fost APK/TWA, retras 2026-08-24). -->
                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowAndroidCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=Android, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicatie mobila" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Separator Margin="16,16" />

                <RadioButton Style="{StaticResource CategoryButtonStyle}" GroupName="Sidebar" Margin="8,1"
                             Command="{Binding ShowLicenseCommand}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageEquals}, ConverterParameter=License, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Key24" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Licenta" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

            </StackPanel>
            </ScrollViewer>

            <!-- Footer FIX (nu scroll-eaza cu restul) - Profil/HWID + versiune,
                 mereu vizibile indiferent de inaltimea ferestrei sau numarul
                 de categorii deasupra. -->
            <StackPanel Grid.Row="1">
                <Separator Margin="16,8" />

                <!-- Profil Utilizator opțional (vezi CLAUDE.md, Partea 1,
                     Regula 12) - Nume/Anonim + Email + Machine ID, editabil
                     prin buton. Port 1:1 al ProfileSidebarBlock.swift (Mac). -->
                <!-- Marit 2026-08-26 (cerut explicit: zona era "miniaturizata,
                     greu de citit") - 12/11/11px -> 14/13/12px, padding
                     vertical marit pe randul editabil. -->
                <TextBlock Text="PROFIL UTILIZATOR" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,6" />
                <Button Click="ProfileEditor_Click" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left" Padding="16,4,16,4" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="{Binding ProfileDisplayName}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding ProfileEmail}" FontSize="13" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock Text="ID MASINA" Style="{StaticResource MutedTextStyle}" Margin="16,4,0,4" />
                <TextBlock Text="{Binding MachineIdDisplay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Margin="16,0,16,0" Style="{StaticResource MutedTextStyle}" />

                <!-- Versiune vizibila in UI, obligatoriu (CLAUDE.md, Partea 1,
                     Regula 7 + Checklist de release) - lipsea complet pe
                     Windows, gasit la audit 2026-08-26 (jurnalul "Faza 3"
                     mintea ca era deja facuta). + buton manual de verificare,
                     mereu arata rezultatul real (nu respecta un dismissal
                     anterior, ca sa nu minta "esti la zi" pe o versiune deja
                     respinsa candva). -->
                <Separator Margin="16,12,16,8" />
                <Grid Margin="16,0,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AppVersionDisplay}" FontSize="11"
                               VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    <Button Grid.Column="1" Content="Caută actualizări" FontSize="11" Padding="8,3"
                            Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource InkBorderBrush}"
                            Click="CheckForUpdates_Click" />
                </Grid>
            </StackPanel>
            </Grid>
        </Border>

        <!-- GridSplitter - face bara laterala redimensionabila manual, tras
             de mouse. Latime vizuala minima (Width="4") dar cu o zona de
             hit-test mai larga (Padding negativ prin ShowsPreview=False
             implicit + cursor SizeWE), usor de apucat fara sa fie un bloc
             vizual gros intre sidebar si continut. -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource InkBorderBrush}" ResizeBehavior="PreviousAndNext" />

        <!-- Continut principal -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================================================================
                 FILIGRAN SEZONIER (Etapa 6, 2026-08-29)
                 NU un banner mic in colt, ci o imagine MARE (~480x480),
                 discreta, "gravata" in fundal: opacitate 7%, IN SPATELE
                 intregului continut (declarat PRIMUL in Grid, deci desenat
                 dedesubt) si cu IsHitTestVisible="False" ca sa nu inghita
                 niciun click destinat cardurilor de deasupra.
                 Stratul nu se randeaza deloc cat timp SeasonalBackground e
                 null (fara filigran publicat, sau incarcare esuata).
                 Randat prin SharpVectors ca DrawingImage — ramane VECTORIAL,
                 deci nu se pixeleaza la dimensiunea asta. Vezi
                 SeasonalBackgroundLoader.cs pentru motivul alegerii librariei.
                 ================================================================ -->
            <Image Grid.Row="0" Grid.RowSpan="3"
                   Source="{Binding SeasonalBackground}"
                   Width="480" Height="480"
                   Opacity="0.07"
                   Stretch="Uniform"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,24,24"
                   IsHitTestVisible="False"
                   Panel.ZIndex="-1"
                   Visibility="{Binding SeasonalBackground, Converter={StaticResource NullToVisibility}}" />

            <!-- Bara de sus: cautare GLOBALA + refresh.
                 ETAPA 1 (2026-08-29): bara NU mai e legata de pagina de
                 catalog (`Visibility` pe CurrentPage a fost ELIMINATA) — e
                 vizibila pe ORICE rubrica, exact ca pe Mac dupa completarea
                 "cautarea a devenit GLOBALA". Cand campul e nevid,
                 `ContentPage` devine `GlobalSearch` si intreg panoul de mai
                 jos se schimba in rezultate combinate din toate colectiile.
                 Filtrul de PRET ramane specific paginii de catalog (randul 1
                 de mai jos); filtrul OS se aplica peste tot. -->
            <Grid Grid.Row="0" Margin="20,20,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SearchBoxBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="15" Margin="10,0,4,0"
                                       Foreground="{StaticResource InkTextMutedBrush}" VerticalAlignment="Center" />
                        <!-- Enter salveaza termenul in istoric (CommitSearchCommand);
                             filtrarea in sine e live, la fiecare tasta
                             (UpdateSourceTrigger=PropertyChanged) — istoricul se
                             scrie doar la confirmare, altfel s-ar umple cu
                             prefixe ("l", "lu", "lut"). -->
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitSearchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}"
                                Background="Transparent" BorderThickness="0" Padding="8,0" FontSize="12"
                                Foreground="{StaticResource InkTextMutedBrush}"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Indicator global 🔴/🟢 Dependinte (vezi CLAUDE.md, Partea 1,
                         Regula 4) — click deschide DependencyPanelWindow.
                         Redesenat 2026-08-26 ca pill Shift real (fundal +
                         bordura definita), aliniat vizual cu varianta Mac
                         (badge-ul "Sistem pregatit" din header), nu doar
                         text plat pe fundal transparent. -->
                    <Button Margin="0,0,10,0" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="DependencyBadge_Click">
                        <Border CornerRadius="12" Padding="10,5" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#332A1D" />
                                    <Setter Property="BorderBrush" Value="#FFE2584A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDependenciesReady}" Value="True">
                                            <Setter Property="Background" Value="#1D2E24" />
                                            <Setter Property="BorderBrush" Value="#FF4CAF7D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FFE2584A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDependenciesReady}" Value="True">
                                                    <Setter Property="Fill" Value="#FF4CAF7D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Necesită atenție" />
                                            <Setter Property="Foreground" Value="#FFE2584A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDependenciesReady}" Value="True">
                                                    <Setter Property="Text" Value="Sistem pregătit" />
                                                    <Setter Property="Foreground" Value="#FF4CAF7D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolean}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="Reincarca" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Filtru rapid Toate/Gratuite/Premium — cerut explicit
                     2026-08-24, ca cine vrea doar uneltele gratuite sa le
                     gaseasca instant. Randat SUB bara de cautare (nu ca rand
                     nou in grid-ul parinte, ca sa nu deranjez numerotarea
                     Grid.Row existenta mai jos, folosita si de RowSpan). -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Filtrul de PRET ramane specific paginii de catalog
                         (produsele sunt singurele cu pret/licenta) — ascuns pe
                         orice alta rubrica si in timpul cautarii globale. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Catalog}">
                        <Button Content="Toate" Margin="0,0,8,0" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.All}"
                                FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=All}" />
                        <Button Content="Gratuite" Margin="0,0,8,0" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.Free}"
                                FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Free}" />
                        <Button Content="Premium" Margin="0,0,20,0" Command="{Binding SetPriceFilterCommand}" CommandParameter="{x:Static vm:PriceFilter.Paid}"
                                FontWeight="{Binding PriceFilter, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Paid}" />
                    </StackPanel>

                    <!-- Filtru OS (Etapa 1) — vizibil pe orice rubrica si in
                         cautarea globala. `CrossPlatform` apare la ORICE
                         optiune (vezi MainViewModel.MatchesOS). Reutilizeaza
                         PriceFilterWeightConverter (compara generic prin
                         ToString), nu un converter nou. -->
                    <TextBlock Text="Sistem:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource MutedTextStyle}" />
                    <Button Content="Toate" Margin="0,0,8,0" Command="{Binding SetOSFilterCommand}" CommandParameter="{x:Static vm:OSFilter.All}"
                            FontWeight="{Binding SelectedOS, Converter={StaticResource PriceFilterWeight}, ConverterParameter=All}" />
                    <Button Content="Mac" Margin="0,0,8,0" Command="{Binding SetOSFilterCommand}" CommandParameter="{x:Static vm:OSFilter.Mac}"
                            FontWeight="{Binding SelectedOS, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Mac}" />
                    <Button Content="Windows" Command="{Binding SetOSFilterCommand}" CommandParameter="{x:Static vm:OSFilter.Windows}"
                            FontWeight="{Binding SelectedOS, Converter={StaticResource PriceFilterWeight}, ConverterParameter=Windows}" />
                </StackPanel>

                <!-- Istoric de cautari recente (max 8, persistat local — vezi
                     SearchHistoryStore.cs). SIMPLIFICARE DELIBERATA fata de
                     Mac: acolo e un dropdown de sugestii ancorat sub camp;
                     aici e un rand de "chip"-uri sub bara, vizibil doar cand
                     campul e GOL (cand se tasteaza, rezultatele live sunt deja
                     sub el si un popup ar concura cu ele). Acelasi continut,
                     fara complexitatea de focus/popup din WPF. -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource RecentSearchesVisible}">
                            <Binding Path="RecentSearches.Count" />
                            <Binding Path="IsSearching" />
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <TextBlock Text="Recente:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource MutedTextStyle}" />
                    <ItemsControl ItemsSource="{Binding RecentSearches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,6,0" Padding="8,3" FontSize="11"
                                        Command="{Binding DataContext.ApplyRecentSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Sterge istoricul" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource InkTextMutedBrush}"
                            Command="{Binding ClearSearchHistoryCommand}" />
                </StackPanel>
            </Grid>

            <!-- Banner update / eroare -->
            <StackPanel Grid.Row="1" Margin="20,10,20,0">
                <Border Background="{StaticResource InkSurfaceRaisedBrush}" CornerRadius="4" Padding="12,8"
                        Visibility="{Binding UpdateBannerText, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="16" Margin="0,0,8,0"
                                           Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateBannerText}" Foreground="{StaticResource BrandBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- WARNING: acest buton lipsea complet. UpdateDownloadUrl era
                                 setat in MainViewModel dar nu era legat de nimic in XAML,
                                 deci banner-ul anunta o versiune noua si nu oferea NICIO
                                 cale de a o lua - nici macar un link. Daca refaci
                                 banner-ul, pastreaza legatura asta. -->
                            <Button Content="Descarcă" Margin="10,0,0,0"
                                    Command="{Binding DownloadUpdateCommand}"
                                    Visibility="{Binding UpdateDownloadUrl, Converter={StaticResource NullToVisibility}}" />
                            <Button Content="Ascunde" Margin="8,0,0,0" Command="{Binding DismissUpdateBannerCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding LoadError}" Foreground="#FFE8544D" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" />

                <!-- Banner dependinte de sistem lipsa — port 1:1 al DependencyBanner (Mac). -->
                <ItemsControl ItemsSource="{Binding MissingDependencies}"
                              Visibility="{Binding MissingDependencies.Count, Converter={StaticResource ZeroToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFCE8CD" CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="#FFB05B00" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="#FFB05B00" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Instalează"
                                            Command="{Binding DataContext.InstallDependencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Pagina Catalog -->
            <ScrollViewer Grid.Row="2" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Catalog}">
                <ItemsControl ItemsSource="{Binding ProductsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pagina Cursuri -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Courses}">
                <StackPanel>
                    <TextBlock Text="Cursuri" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun curs disponibil momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Courses.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Courses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Materiale -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=EducationalResources}">
                <StackPanel>
                    <TextBlock Text="Materiale" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun material disponibil momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding EducationalResources.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding EducationalResources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Evenimente -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Events}">
                <StackPanel>
                    <TextBlock Text="Evenimente" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun eveniment momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Events.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Magazine partenere -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=PartnerStores}">
                <StackPanel>
                    <TextBlock Text="Magazine partenere" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun magazin partener momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding PartnerStores.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PartnerStores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Service & Reparatii -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=ServiceCenters}">
                <StackPanel>
                    <TextBlock Text="Service &amp; Reparații Echipament" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun service partener momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding ServiceCenters.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ServiceCenters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Audio -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=AudioTracks}">
                <StackPanel>
                    <TextBlock Text="Audio" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun element audio listat momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding AudioTracks.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Aplicatii -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Apps}">
                <StackPanel>
                    <TextBlock Text="Aplicatii" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio aplicatie listata momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Aplicatie mobila — fost "Android"/APK, RETRAS 2026-08-24
                 (cerut explicit: fara certificate, fara erori de instalare,
                 fara APK). Acum e direct PWA-ul gordas.dev/app.html, deschis
                 in browser — merge pe Android SI iPhone. Link fix
                 (MainViewModel.MobileAppUrl), fara nicio cerere de retea.
                 Cod QR: MobileAppQrImage, generat o singura data cu QRCoder
                 (vezi QrCodeImageGenerator.cs). Fundal alb obligatoriu: QR-ul
                 are nevoie de contrast ca sa fie citit, la fel ca pe Mac. -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Android}">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Aplicatia mobila" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Ai catalogul GDC si pe telefon: produse, cursuri, evenimente si magazine partenere, cu functionare offline. Scaneaza codul de mai jos, direct din browser, fara instalare — merge pe Android si pe iPhone." />

                    <Border Background="White" CornerRadius="10" Padding="10" Width="188" Height="188"
                            HorizontalAlignment="Left" Margin="0,0,0,14"
                            Visibility="{Binding MobileAppQrImage, Converter={StaticResource NullToVisibility}}">
                        <Image Source="{Binding MobileAppQrImage}" Width="168" Height="168"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" FontFamily="Consolas"
                               Text="gordas.dev/app.html" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <ui:Button Content="Deschide" Appearance="Primary"
                                   Command="{Binding OpenAndroidPageCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Copiaza linkul" Command="{Binding CopyAndroidLinkCommand}" />
                    </StackPanel>

                    <TextBlock Text="Adauga pe ecranul principal (optional)" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Text="Android (Chrome)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="1. Deschide linkul in Chrome, apoi apasa meniul (⋮) din dreapta sus." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="2. Alege &quot;Adauga pe ecranul principal&quot; — primesti un icon, ca o aplicatie instalata." />
                    <TextBlock Text="iPhone (Safari)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="1. Deschide linkul in Safari, apoi apasa butonul de partajare (patratul cu sageata in sus)." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="2. Alege &quot;Adauga pe ecranul principal&quot; din lista." />
                </StackPanel>
            </ScrollViewer>

            <!-- Pagina Licenta -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=License}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left" DataContext="{Binding LicensePane}">
                    <TextBlock Text="Licenta" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,4" />

                    <!-- Status -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                                        <Setter Property="Text" Value="Niciun produs deblocat inca" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                <Setter Property="Text" Value="Produse deblocate" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Text" Value="Aplicatia e gratuita — rasfoieste catalogul si cumpara doar ce vrei sa folosesti." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                                <Setter Property="Text" Value="Ai produs(e) deblocat(e) pe viata, pe acest calculator." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Licentele mele -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0"
                            Visibility="{Binding IsLicensed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Licentele mele" Style="{StaticResource HeadingTextStyle}" />
                            <ItemsControl ItemsSource="{Binding OwnedLicenses}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OwnedLicenseViewModel}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Dezactiveaza" Padding="8,3" Command="{Binding DeactivateCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ID masina -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ID-ul acestui calculator" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Trimite acest ID cand cumperi licenta — codul e legat de acest calculator."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource InkBackgroundBrush}" BorderBrush="{StaticResource InkBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding MachineIdDisplay}" FontFamily="Consolas" />
                                </Border>
                                <Button Content="Copiaza" Margin="10,0,0,0" Command="{Binding CopyMachineIdCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activare cod -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding ActivationError}" Foreground="#FFE8544D" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding ActivationError, Converter={StaticResource NullToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding JustActivated, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{StaticResource BrandBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Activat cu succes!" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                            <Button Content="Activeaza" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Padding="20,7" Command="{Binding ActivateCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Cumpara / doneaza -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Vrei sa deblochezi un produs?" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Suma de pe fiecare card e o donatie, o singura data, care ajuta la dezvoltarea in continuare a produselor - nu un pret de vanzare."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="20,7"
                                    Command="{Binding OpenWhatsAppCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChatBubblesQuestion24" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Scrie-ne pe WhatsApp" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================
                 PACHETE / BUNDLE-URI (Etapa 9, 2026-08-29)
                 ================================================================ -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=Bundles}">
                <StackPanel>
                    <TextBlock Text="Pachete" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Niciun pachet disponibil momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Bundles.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Bundles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================
                 OFERTE PARTENERI (Etapa 4, 2026-08-29)
                 Filtrate deja de scheduling in MainViewModel — o oferta
                 expirata nu ajunge niciodata in colectie.
                 ================================================================ -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=PartnerOffers}">
                <StackPanel>
                    <TextBlock Text="Oferte Parteneri" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio oferta activa momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding PartnerOffers.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PartnerOffers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================
                 APLICATIILE MELE (Etapa 3, 2026-08-29)
                 Aplicatiile GDC gasite instalate pe masina asta (Registry,
                 cheile de dezinstalare Inno Setup) + scurtaturi personalizate
                 alese de user. Port al `MyAppsLauncher.swift` (Mac).
                 ================================================================ -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=MyApps}">
                <StackPanel DataContext="{Binding MyApps}">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Aplicatiile Mele" Style="{StaticResource HeadingTextStyle}" FontSize="20" />
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBoolean}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Rescaneaza" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Aplicatiile GDC instalate pe acest calculator. Detectarea se face dupa prezenta aplicatiei (nu dupa licenta) — fiecare aplicatie GDC isi tine activarea separat." />

                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Nicio aplicatie GDC gasita pe acest calculator."
                               Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding InstalledApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="300">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                                                       FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <!-- Badge ACTUALIZARE doar cand chiar stim ca exista
                                                 o versiune mai noua (verificarea a reusit). -->
                                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="#FF4EA1F5"
                                                    ToolTip="{Binding UpdateTooltip}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="ACTUALIZARE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding InstalledVersionDisplay}" Style="{StaticResource MutedTextStyle}"
                                                   FontSize="12" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LaunchCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Lanseaza" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="8,0,0,0" Command="{Binding OpenSiteCommand}"
                                                    ToolTip="Deschide pagina aplicatiei"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="15" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Scurtaturi personalizate — orice .exe (Resolve, Premiere,
                         Photoshop...), persistate local. -->
                    <Separator Margin="0,18,0,14" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scurtaturile mele" Style="{StaticResource HeadingTextStyle}"
                                   FontSize="16" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding AddCustomLauncherCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Adauga aplicatie" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Nicio scurtatura adaugata inca."
                               Visibility="{Binding CustomLaunchers.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding CustomLaunchers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,14" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingTextStyle}"
                                                   FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LaunchCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Lanseaza" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="8,0,0,0" Command="{Binding RemoveCommand}" ToolTip="Elimina scurtatura">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================
                 RESURSE DOWNLOAD (Etapa 2) — 4 pagini, una per categorie.
                 Toate patru sunt identice ca structura (mirror al paginii
                 Audio); difera doar titlul si colectia legata.
                 ================================================================ -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=DownloadLut}">
                <StackPanel>
                    <TextBlock Text="LUT-uri" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio resursa disponibila momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding DownloadLuts.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DownloadLuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=DownloadSfx}">
                <StackPanel>
                    <TextBlock Text="Efecte Audio" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio resursa disponibila momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding DownloadSfx.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DownloadSfx}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=DownloadVfx}">
                <StackPanel>
                    <TextBlock Text="Efecte Video" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio resursa disponibila momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding DownloadVfx.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DownloadVfx}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=DownloadPlugin}">
                <StackPanel>
                    <TextBlock Text="Plugin-uri" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />
                    <TextBlock Text="Nicio resursa disponibila momentan." Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding DownloadPlugins.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DownloadPlugins}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================================
                 REZULTATE CAUTARE GLOBALA (Etapa 1, 2026-08-29)
                 Port 1:1 al `GlobalSearchResults` din ContentView.swift (Mac).
                 Inlocuieste continutul rubricii curente cand campul de cautare
                 e nevid (vezi MainViewModel.ContentPage). Fiecare sectiune se
                 randa DOAR daca are cel putin o potrivire — un titlu fara
                 rezultate nu apare deloc (NonZeroToVisibility).
                 Reutilizeaza DataTemplate-urile de card deja definite in
                 Window.Resources (rezolvate automat dupa DataType) — zero cod
                 de UI duplicat, exact ca pe Mac.
                 ================================================================ -->
            <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Margin="20,20,20,20" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ContentPage, Converter={StaticResource PageVisible}, ConverterParameter=GlobalSearch}">
                <StackPanel>
                    <TextBlock Text="Rezultatele cautarii" Style="{StaticResource HeadingTextStyle}" FontSize="20" Margin="0,0,0,14" />

                    <TextBlock Text="Niciun rezultat. Incearca alt termen sau schimba filtrul de sistem."
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Produse -->
                    <StackPanel Visibility="{Binding GlobalProducts.Count, Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="Produse" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,6,0,8" />
                        <ItemsControl ItemsSource="{Binding GlobalProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Resurse Download (a 9-a colectie, Etapa 2) -->
                    <StackPanel Visibility="{Binding GlobalDownloadResources.Count, Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="Resurse Download" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,14,0,8" />
                        <ItemsControl ItemsSource="{Binding GlobalDownloadResources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Audio -->
                    <StackPanel Visibility="{Binding GlobalAudioTracks.Count, Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="Audio" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,14,0,8" />
                        <ItemsControl ItemsSource="{Binding GlobalAudioTracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Cursuri -->
                    <StackPanel Visibility="{Binding GlobalCourses.Count, Converter={StaticResource NonZeroToVisibility}}">
                        <TextBlock Text="Cursuri" Style="{StaticResource HeadingTextStyle}" FontSize="15" Margin="0,14,0,8" />
                        <ItemsControl ItemsSource="{Binding GlobalCourses}">
