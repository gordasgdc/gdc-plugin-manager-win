<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite dotnet restore/build sa rezolve TFM-ul windows si de pe macOS,
         doar cat sa verificam sintaxa C#/XAML aici — nu inlocuieste un build
         real pe Windows (compilarea XAML->BAML necere PresentationBuildTasks,
         disponibil doar pe Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GDCPluginManager.Client</RootNamespace>
    <AssemblyName>GDCPluginManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Acelasi numar ca versiunea Mac (docs/update.json foloseste un singur
         camp "version" comun ambelor platforme) — UpdateChecker.CurrentVersion
         citeste asta prin Assembly.GetEntryAssembly().GetName().Version. -->
    <Version>1.27.1</Version>
    <!-- Iconita exe-ului si a ferestrei (Assets\app.ico — generata din
         AppIcon.icns de pe Mac, ca cele doua clienti sa aiba acelasi logo). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ObservableObject / RelayCommand / [ObservableProperty] source generators -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.5" />
    <!-- Iconite vectoriale Fluent (Segoe Fluent Icons look, nativ pe Windows 11) + FluentWindow. -->
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <!-- Cod QR pentru pagina Android (link direct catre .apk) — pana acum
         lipsea intentionat pe Windows (WPF n-are generator inclus), dar
         QRCoder e mic, MIT, fara System.Drawing.Common (PngByteQRCode
         produce direct bytes PNG, pur managed) — nicio dependinta grea
         pentru un cod QR local, la fel ca CIFilter.qrCodeGenerator() pe Mac. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Extragere iconita REALA din .exe (Aplicatiile Mele / Scurtaturi) —
         echivalent NSWorkspace.icon(forFile:) de pe Mac. Folosit DOAR pentru
         a citi iconita unei aplicatii deja instalate pe masina userului
         (exact ce face Explorer) — nu bundle-uim nicio sigla tert-parte
         (Adobe/Blackmagic etc.) in cod, evitand orice risc de marca
         inregistrata. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDCPluginManager.Core\GDCPluginManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Acelasi fisier, expus si ca Resource WPF (pack URI), pentru
         Window.Icon (title bar/taskbar la runtime) — ApplicationIcon de mai
         sus seteaza doar iconita exe-ului in Explorer. -->
    <Resource Include="Assets\app.ico" />
    <!-- Iconite de brand colorate (2026-08-29, CLAUDE.md Regula social
         links) — PNG, nu SVG: lectia de pe Mac (ImageIO nu randeaza <text>)
         a fost portata ca precautie generala, plus WPF/BitmapImage decodeaza
         PNG nativ, fara nicio dependinta suplimentara. -->
    <Resource Include="Assets\Social\facebook.png" />
    <Resource Include="Assets\Social\youtube.png" />
    <Resource Include="Assets\Social\instagram.png" />
    <Resource Include="Assets\Social\tiktok.png" />
    <Resource Include="Assets\Social\linkedin.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Python 3.12 embeddable oficial (python.org), ~22MB — bundle-uit langa
         exe, ca PowerGradeImporter sa NU mai depinda de un Python instalat
         separat de client. CopyToPublishDirectory e obligatoriu si pentru
         dotnet publish (nu doar build); PreserveNewest evita recopierea
         inutila la fiecare build. -->
    <None Include="PythonRuntime\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
