<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema "Shift" (2026-08-26, vezi CLAUDE.md Partea 1 Regula 7/12) —
         dark, profesional, inspirat de paginile de Color din DaVinci
         Resolve: fundal aproape negru, accent amber/cupru. Aceleasi valori
         hex ca varianta Mac (Theme.swift, CGConvertor) si gordas.dev —
         inlocuieste paleta verde-teal folosita anterior aici. -->
    <Color x:Key="BrandColor">#FFE8963C</Color>
    <Color x:Key="BrandDarkColor">#FFB96A1E</Color>
    <Color x:Key="InkBackgroundColor">#FF14161A</Color>
    <Color x:Key="InkSurfaceColor">#FF1A1D22</Color>
    <Color x:Key="InkSurfaceRaisedColor">#FF20232A</Color>
    <Color x:Key="InkBorderColor">#FF2B2F36</Color>
    <Color x:Key="InkTextColor">#FFEDEFF2</Color>
    <Color x:Key="InkTextMutedColor">#FF93989F</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="InkBackgroundBrush" Color="{StaticResource InkBackgroundColor}" />
    <SolidColorBrush x:Key="InkSurfaceBrush" Color="{StaticResource InkSurfaceColor}" />
    <SolidColorBrush x:Key="InkSurfaceRaisedBrush" Color="{StaticResource InkSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InkBorderBrush" Color="{StaticResource InkBorderColor}" />
    <SolidColorBrush x:Key="InkTextBrush" Color="{StaticResource InkTextColor}" />
    <SolidColorBrush x:Key="InkTextMutedBrush" Color="{StaticResource InkTextMutedColor}" />
</ResourceDictionary>
