<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource InkBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkTextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource InkSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBackgroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CategoryButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InkTextMutedBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InkSurfaceRaisedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InkSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bara de cautare: container cu iconita Search24 in stanga + TextBox fara bordura proprie. -->
    <Style x:Key="SearchBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InkSurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Buton-iconita din randul de linkuri suplimentare al unui card
         (Etapa 2, 2026-08-29): cumpara extern / demo / Facebook / YouTube /
         Instagram / TikTok. Discret pe fundalul cardului — fara chenar, fara
         fundal — ca sa nu concureze vizual cu butonul principal de actiune
         (Instaleaza/Descarca/Deblocheaza). -->
    <Style x:Key="ExtraLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource InkTextMutedBrush}" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
    </Style>

    <!-- Sectiune pliabila din bara laterala (2026-09-14). Paritate cu
         `Section(isExpanded:)` de pe Mac: acelasi titlu marunt, majuscule,
         cu o sageata care se roteste lin la deschidere/inchidere.
         ControlTemplate propriu, nu Expander-ul implicit: acela vine cu
         chenar, fundal si o sageata triunghiulara care nu seamana deloc cu
         restul barei. -->
    <Style x:Key="SidebarSectionStyle" TargetType="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Cursor="Hand" Focusable="True" HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder" Background="Transparent" Padding="16,6,12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{TemplateBinding Content}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource InkTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <Path x:Name="Chevron" Grid.Column="1" Width="8" Height="8"
                                                  Data="M 0,0 L 4,4 L 0,8"
                                                  Stroke="{DynamicResource InkTextMutedBrush}" StrokeThickness="1.5"
                                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background"
                                                    Value="{DynamicResource InkSurfaceRaisedBrush}" />
                                        </Trigger>
                                        <!-- Rotatia sagetii: un singur Trigger cu
                                             EnterActions/ExitActions, nu EventTriggers pe
                                             Checked/Unchecked.
                                             MOTIV: acelea se declanseaza doar la o SCHIMBARE
                                             de stare, deci o sectiune salvata ca deschisa s-ar
                                             fi desenat cu sageata in pozitia de "inchis" pana
                                             la primul click. EnterActions ruleaza si atunci
                                             cand conditia e deja adevarata la incarcare, deci
                                             acopera si starea initiala, si animatia.
                                             Tinta e data prin cale de proprietate, nu prin
                                             x:Name-ul transformarii: un Setter nu poate tinti
                                             un RotateTransform (nu e element din sablon). -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="90" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
