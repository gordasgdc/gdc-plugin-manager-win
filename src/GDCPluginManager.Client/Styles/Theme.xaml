<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema "Shift" (2026-08-26, vezi CLAUDE.md Partea 1 Regula 7/12) —
         dark, profesional, inspirat de paginile de Color din DaVinci
         Resolve: fundal aproape negru, accent amber/cupru. Aceleasi valori
         hex ca varianta Mac (Theme.swift, CGConvertor) si gordas.dev —
         inlocuieste paleta verde-teal folosita anterior aici. -->
    <Color x:Key="BrandColor">#FFE8963C</Color>
    <Color x:Key="BrandDarkColor">#FFB96A1E</Color>
    <Color x:Key="InkBackgroundColor">#FF14161A</Color>
    <Color x:Key="InkSurfaceColor">#FF1A1D22</Color>
    <Color x:Key="InkSurfaceRaisedColor">#FF20232A</Color>
    <Color x:Key="InkBorderColor">#FF2B2F36</Color>
    <Color x:Key="InkTextColor">#FFEDEFF2</Color>
    <Color x:Key="InkTextMutedColor">#FF93989F</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="InkBackgroundBrush" Color="{StaticResource InkBackgroundColor}" />
    <SolidColorBrush x:Key="InkSurfaceBrush" Color="{StaticResource InkSurfaceColor}" />
    <SolidColorBrush x:Key="InkSurfaceRaisedBrush" Color="{StaticResource InkSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InkBorderBrush" Color="{StaticResource InkBorderColor}" />
    <SolidColorBrush x:Key="InkTextBrush" Color="{StaticResource InkTextColor}" />
    <SolidColorBrush x:Key="InkTextMutedBrush" Color="{StaticResource InkTextMutedColor}" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource InkBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InkSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBackgroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CategoryButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkTextMutedBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource InkSurfaceRaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource InkSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrandBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bara de cautare: container cu iconita Search24 in stanga + TextBox fara bordura proprie. -->
    <Style x:Key="SearchBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InkSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InkSurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Buton-iconita din randul de linkuri suplimentare al unui card
         (Etapa 2, 2026-08-29): cumpara extern / demo / Facebook / YouTube /
         Instagram / TikTok. Discret pe fundalul cardului — fara chenar, fara
         fundal — ca sa nu concureze vizual cu butonul principal de actiune
         (Instaleaza/Descarca/Deblocheaza). -->
    <Style x:Key="ExtraLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{StaticResource InkTextMutedBrush}" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
    </Style>

</ResourceDictionary>
