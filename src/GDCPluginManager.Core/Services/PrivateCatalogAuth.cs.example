namespace GDCPluginManager.Core.Services;

/// Template — copiaza in PrivateCatalogAuth.cs (gitignored) si completeaza
/// Token cu acelasi token read-only folosit pe Mac
/// (Sources/GDCPluginManagerCore/PrivateCatalogAuth.swift), inainte de a
/// compila un client Windows real. Vezi Furnizor -> "Cum reinnoiesc
/// token-ul GitHub?" daca ai nevoie sa generezi unul nou.
public static class PrivateCatalogAuth
{
    public const string Owner = "gordasgdc";
    public const string Repo = "gdc-plugin-manager-files";

    // WARNING: this literal string "PASTE_TOKEN_HERE" is a required placeholder —
    // build-windows.yml's `-replace 'PASTE_TOKEN_HERE', secret` step depends on it
    // matching EXACTLY. If this ever gets "cleaned up" to Token = "", the CI
    // substitution silently does nothing and every build ships with an empty
    // token (401/403 on every download). Bug found 2026-08-21 the hard way.
    public const string Token = "PASTE_TOKEN_HERE";
}
