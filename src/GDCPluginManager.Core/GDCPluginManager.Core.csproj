<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GDCPluginManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ed25519 pentru LicenseCore (.NET nu are suport nativ pentru Ed25519 pe net8.0). -->
